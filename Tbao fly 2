local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")

local flying = false
local speed = 60

local gui = Instance.new("ScreenGui")
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 160, 0, 60)
button.Position = UDim2.new(0.5, -80, 0.75, 0)
button.Text = "✈️ BAY: TẮT"
button.TextScaled = true
button.Parent = gui

local bv
local bg

button.Activated:Connect(function()
	flying = not flying

	if flying then
		button.Text = "✈️ BAY: BẬT"

		bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.zero
		bv.Parent = root

		bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bg.P = 90000
		bg.Parent = root
	else
		button.Text = "✈️ BAY: TẮT"

		if bv then bv:Destroy() bv = nil end
		if bg then bg:Destroy() bg = nil end
	end
end)

RunService.RenderStepped:Connect(function()
	if not flying or not bv or not bg then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local cam = workspace.CurrentCamera

	if humanoid then
		bv.Velocity = humanoid.MoveDirection * speed
	end

	bg.CFrame = cam.CFrame
end)
